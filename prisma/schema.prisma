// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   // "ADMIN" or "WORKER"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id            String   @id @default(cuid())
  name          String   @unique
  purchasePrice Float
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions  Transaction[]
}

model Seller {
  id            String   @id @default(cuid())
  name          String   @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions  Transaction[]
}

model Transaction {
  id            String   @id @default(cuid())
  type          String   // "INICIO", "VENTA", "GASTO", "CIERRE"
  date          DateTime @default(now())
  
  // Fields for specific transaction types
  amount        Float?   // Used for INICIO, GASTO, CIERRE

  // Sale specific fields
  productId     String?
  product       Product? @relation(fields: [productId], references: [id])
  sellerId      String?
  seller        Seller?  @relation(fields: [sellerId], references: [id])
  
  purchasePrice Float?
  salePrice     Float?
  profit        Float?
  commission    Float?
  storeProfit   Float?
  
  // Gasto specific fields
  reason        String?
  
  // Payment method
  paymentMethod String?  // "EFECTIVO", "TRANSFERENCIA", "NEQUI", "DAVIPLATA"
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
